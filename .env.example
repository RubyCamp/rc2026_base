# Docker Compose内のローカルPostgreSQL
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/rc2026_base_development
TEST_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/rc2026_base_test

# ホストへ公開するポート
RAILS_PORT=3000
POSTGRES_PORT=5432

# ChangeEventのdebug表示
ENABLE_CHANGE_EVENT_DEBUG=false

# 共有DBを使用する場合は、DATABASE_URLを指定された値へ差し替える
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME
