<div id="assignment-status-<%= assignment.id %>" class="d-inline">
  <% if assignment.draft? %>
    <% work_request = assignment.work_request %>
    <% skill_missing = !StaffMember.skilled_for(work_request_id: work_request.id).exists?(id: assignment.staff_member_id) %>
    <% time_conflict = Assignment.time_conflict?(id: assignment.id) %>
    <% issues = [] %>
    <% issues << "スキル不足" if skill_missing %>
    <% issues << "時間重複" if time_conflict %>
    <% issues << "人数不足" unless work_request.staffing_sufficient? %>
    <% if issues.any? %>
      <span class="badge text-bg-danger me-2">仮割り当て（<%= issues.join("・") %>）</span>
    <% else %>
      <%= button_to "仮割り当て", confirm_list_view_path(assignment), method: :patch, params: { modal_toggle: true }, class: "badge border-0 text-bg-warning me-2", form: { class: "d-inline", data: { turbo_stream: true } } %>
    <% end %>
  <% else %>
    <%= button_to "確定済み", unconfirm_list_view_path(assignment), method: :patch, params: { modal_toggle: true }, class: "badge border-0 text-bg-primary me-2", form: { class: "d-inline", data: { turbo_stream: true } } %>
  <% end %>
</div>
