<% content_for :title, "ログイン" %>

<div class="mb-4">
  <p class="mb-1 text-primary fw-semibold">勤務調整システム</p>
  <h1 class="display-6 fw-bold">ログイン</h1>
  <p class="page-lead text-body-secondary">ご自身の役割を選択してください。</p>
</div>

<div class="accordion" id="role-accordion">
  <div class="accordion-item">
    <h2 class="accordion-header">
      <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#role-admin" aria-expanded="true" aria-controls="role-admin">管理者</button>
    </h2>
    <div id="role-admin" class="accordion-collapse collapse show" data-bs-parent="#role-accordion">
      <div class="accordion-body"><%= button_to "管理者としてログイン", login_path, params: { role: "admin" }, class: "btn btn-primary" %></div>
    </div>
  </div>
  <div class="accordion-item">
    <h2 class="accordion-header">
      <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#role-business" aria-expanded="false" aria-controls="role-business">事業者</button>
    </h2>
    <div id="role-business" class="accordion-collapse collapse" data-bs-parent="#role-accordion">
      <div class="accordion-body vstack gap-2 align-items-start">
        <% if @businesses.any? %>
          <% @businesses.each do |business| %>
            <%= button_to business.name, login_path, params: { role: "business", business_id: business.id }, class: "btn btn-outline-primary" %>
          <% end %>
        <% else %>
          <p class="text-body-secondary mb-0">選択可能な事業者がありません。</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
