<% content_for :title, @work_request.title %>

<p><%= link_to "勤務依頼一覧へ戻る", details_of_shifts_path, class: "link-secondary" %></p>
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4"><div><p class="mb-1 text-primary fw-semibold"><%= @work_request.business.name %></p><h1 class="display-6 fw-bold"><%= @work_request.title %></h1><p class="text-body-secondary"><%= l @work_request.starts_at, format: :long %> 〜 <%= l @work_request.ends_at, format: :long %></p></div><span class="badge text-bg-primary"><%= enum_label(@work_request, :status) %></span></div>

<section class="card shadow-sm mb-4"><div class="card-body"><h2 class="h4 card-title">依頼条件</h2><dl class="definition-list mb-0"><div><dt>必要人数</dt><dd><%= @work_request.required_staff_count %>名</dd></div><div><dt>割当済み</dt><dd><%= @work_request.assignments.size %>名</dd></div><div><dt>不足人数</dt><dd><%= @work_request.staffing_shortage_count %>名</dd></div><div><dt>必要スキル</dt><dd><%= @work_request.required_skill&.name || "指定なし" %></dd></div></dl></div></section>

<section class="card shadow-sm mb-4"><div class="card-body"><div class="d-flex justify-content-between align-items-center gap-3 mb-3"><h2 class="h4 card-title mb-0">候補スタッフ</h2><%= link_to "この勤務依頼を割り当てる", work_request_path(@work_request), class: "btn btn-outline-primary btn-sm" %></div><% if @staff_members.any? %><ul class="list-group list-group-flush"><% @staff_members.each do |staff_member| %><li class="list-group-item px-0 d-flex justify-content-between"><span><strong><%= staff_member.name %></strong><span class="text-body-secondary ms-2"><%= staff_member.skills.map(&:name).join("、") %></span></span><%= link_to "割当画面", work_request_path(@work_request), class: "link-primary" %></li><% end %></ul><% else %><p class="mb-0 text-body-secondary">勤務可能な候補スタッフはいません。</p><% end %></div></section>

<section class="card shadow-sm"><div class="card-body"><h2 class="h4 card-title">現在の割当</h2><% if @work_request.assignments.any? %><ul class="list-group list-group-flush"><% @work_request.assignments.each do |assignment| %><li class="list-group-item px-0 d-flex justify-content-between"><strong><%= assignment.staff_member.name %></strong><span class="badge text-bg-secondary"><%= enum_label(assignment, :status) %></span></li><% end %></ul><% else %><p class="mb-0 text-body-secondary">まだスタッフは割り当てられていません。</p><% end %></div></section>
