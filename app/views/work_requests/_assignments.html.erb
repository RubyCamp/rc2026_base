<section class="card shadow-sm">
  <div class="card-body">
    <h2 class="h4 card-title">現在の割当</h2>
    <% if assignments.any? %>
      <ul class="list-group list-group-flush">
        <% assignments.each do |assignment| %>
          <% work_request = assignment.work_request %>
          <% skill_missing = !StaffMember.skilled_for(work_request_id: work_request.id).exists?(id: assignment.staff_member_id) %>
          <% time_conflict = Assignment.time_conflict?(id: assignment.id) %>
          <% has_warning = skill_missing || time_conflict %>
          <li class="list-group-item px-0 d-flex flex-wrap justify-content-between align-items-center gap-2 <%= "list-group-item-danger" if has_warning %>">
            <div>
              <strong><%= assignment.staff_member.name %></strong>
              <% if has_warning %>
                <div class="mt-1">
                  <% if skill_missing %><span class="badge text-bg-danger">スキル不足</span><% end %>
                  <% if time_conflict %><span class="badge text-bg-danger">時間重複</span><% end %>
                </div>
              <% end %>
            </div>
            <span class="badge text-bg-secondary"><%= enum_label(assignment, :status) %></span>
            <% if assignment.draft? %>
              <%= button_to "確定する", confirm_list_view_path(assignment), method: :patch, class: "btn btn-primary btn-sm" %>
              <%= button_to "解除", work_request_assignment_path(work_request_id: assignment.work_request_id, id: assignment.id), method: :delete, class: "btn btn-outline-danger btn-sm", form: { data: { turbo_confirm: "この仮割り当てを解除しますか？" } } %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mb-0 text-body-secondary">まだスタッフは割り当てられていません。</p>
    <% end %>
  </div>
</section>
