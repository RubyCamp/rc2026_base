<% content_for :title, @work_request.title %>

<p>
  <%= link_to "勤務依頼一覧へ戻る", work_requests_path, class: "link-secondary" %>
</p>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">
  <div>
    <p class="mb-1 text-primary fw-semibold"><%= @work_request.business.name %></p>
    <h1 class="display-6 fw-bold"><%= @work_request.title %></h1>
    <p class="text-body-secondary">
      <%= l @work_request.starts_at, format: :long %> 〜 <%= l @work_request.ends_at, format: :long %>
    </p>
  </div>

  <div class="d-flex align-items-center gap-2">
    <span class="badge text-bg-primary"><%= enum_label(@work_request, :status) %></span>
    <% if @work_request.confirmable? %>
      <%= button_to "受付を終了する", confirm_work_request_path(@work_request), method: :patch, class: "btn btn-primary btn-sm" %>
    <% end %>
  </div>
</div>

<div class="d-flex flex-wrap justify-content-end gap-2 mb-4">
  <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#draftAssignmentModal">仮割当</button>
  <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#unassignAssignmentModal">仮割当全解除</button>
  <%= link_to "仮割当を評価する", list_views_path, class: "btn btn-outline-primary" %>
  <%= link_to "人員状況で確認", details_of_shift_path(@work_request), class: "btn btn-outline-secondary" %>
</div>

<section class="card shadow-sm mb-4">
  <div class="card-body">
    <h2 class="h4 card-title">依頼条件</h2>
    <dl class="definition-list mb-0">
      <div><dt>必要人数</dt><dd><%= @work_request.required_staff_count %>名</dd></div>
      <div><dt>必要スキル</dt><dd><%= @work_request.required_skill&.name || "指定なし" %></dd></div>
      <div><dt>割当済み</dt><dd><span id="work-request-assigned-count"><%= @work_request.assignments.size %></span>名</dd></div>
      <div><dt>不足人数</dt><dd><%= @work_request.staffing_shortage_count %>名</dd></div>
      <div><dt>勤務時間</dt><dd><%= l @work_request.starts_at, format: :long %> 〜 <%= l @work_request.ends_at, format: :long %></dd></div>
    </dl>
  </div>
</section>

<section class="card shadow-sm mb-4">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
      <h2 class="h4 card-title mb-0">備考</h2>
      <%= link_to "備考を編集", edit_work_request_path(@work_request), class: "btn btn-outline-primary" %>
    </div>
    <% if @work_request.notes.present? %>
      <%= simple_format @work_request.notes, class: "mb-0" %>
    <% else %>
      <p class="mb-0 text-body-secondary">備考はありません。</p>
    <% end %>
  </div>
</section>

<section class="card shadow-sm mb-4">
  <div class="card-body">
    <h2 class="h4 card-title mb-3">スタッフを仮割り当て</h2>
    <% if @assignable_staff_members.any? %>
      <div class="dropdown">
        <button class="btn btn-outline-primary dropdown-toggle w-100 text-start" type="button" data-bs-toggle="dropdown" aria-expanded="false">スタッフを選択</button>
        <ul class="dropdown-menu w-100">
          <% @assignable_staff_members.each do |staff_member| %>
            <% skill_missing = @work_request.required_skill_id.present? && staff_member.skills.none? { |skill| skill.id == @work_request.required_skill_id } %>
            <% time_conflict = Assignment.time_conflict_for?(work_request_id: @work_request.id, staff_member_id: staff_member.id) %>
            <li>
              <%= button_to assign_work_request_path(@work_request), method: :post, params: { staff_member_id: staff_member.id }, class: "dropdown-item d-flex justify-content-between align-items-center gap-3", form: { class: "m-0" } do %>
                <span><strong><%= staff_member.name %></strong><span class="text-body-secondary ms-2"><%= staff_member.skills.map(&:name).join("、").presence || "スキルなし" %></span></span>
                <% if skill_missing || time_conflict %>
                  <span class="d-flex gap-1">
                    <% if skill_missing %><span class="badge text-bg-danger">スキル不足</span><% end %>
                    <% if time_conflict %><span class="badge text-bg-danger">時間重複</span><% end %>
                  </span>
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% else %>
      <p class="mb-0 text-body-secondary">割り当て可能なスタッフはいません。</p>
    <% end %>
  </div>
</section>

<turbo-frame id="work-request-assignments">
  <%= render "work_requests/assignments", assignments: @work_request.assignments %>
</turbo-frame>

<div class="modal fade" id="draftAssignmentModal" tabindex="-1" aria-labelledby="draftAssignmentModalLabel" aria-hidden="true">
  <div class="modal-dialog"><div class="modal-content">
    <div class="modal-header">
      <h2 class="modal-title fs-5" id="draftAssignmentModalLabel">仮割当の確認</h2>
      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
    </div>
    <div class="modal-body" id="draft-assignment-result">仮割当を実行しますか？</div>
    <div class="modal-footer" id="draft-assignment-modal-footer">
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">キャンセル</button>
      <%= button_to "実行する", draft_path(id: @work_request.id), method: :post, class: "btn btn-primary", form: { data: { turbo_stream: true } } %>
    </div>
  </div></div>
</div>

<div class="modal fade" id="unassignAssignmentModal" tabindex="-1" aria-labelledby="unassignAssignmentModalLabel" aria-hidden="true">
  <div class="modal-dialog"><div class="modal-content">
    <div class="modal-header">
      <h2 class="modal-title fs-5" id="unassignAssignmentModalLabel">仮割当解除の確認</h2>
      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
    </div>
    <div class="modal-body">仮割当を全解除しますか？</div>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">キャンセル</button>
      <%= button_to "全解除する", unassign_all_path(id: @work_request.id), method: :delete, class: "btn btn-primary" %>
    </div>
  </div></div>
</div>
