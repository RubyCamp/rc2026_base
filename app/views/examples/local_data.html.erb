<% content_for :title,
               "独自機能向けローカルデータ見本" %>

<p>
  <%= link_to "勤務依頼一覧へ戻る",
              root_path,
              class: "link-secondary" %>
</p>

<div class="mb-4">
  <p class="mb-1 text-primary fw-semibold">
    任意機能の実装見本
  </p>

  <h1 class="display-6 fw-bold">
    静的JSONとブラウザ保存
  </h1>

  <p class="page-lead text-body-secondary">
    チーム独自の読取専用データと、
    端末内だけで使う簡易メモの最小例です。
  </p>
</div>

<section class="card shadow-sm mb-4">
  <div class="card-body">
    <h2 class="h4 card-title">
      静的JSONから読み取った集合場所
    </h2>

    <p class="text-body-secondary">
      リポジトリ内の
      <code>config/examples/team_locations.json</code>
      を読み取っています。
      標準課題の業務データではありません。
    </p>

    <ul class="list-group list-group-flush">
      <% @locations.each do |location| %>
        <li class="list-group-item px-0">
          <strong><%= location[:name] %></strong>
          ：
          <%= location[:description] %>
        </li>
      <% end %>
    </ul>
  </div>
</section>

<section
  class="card shadow-sm"
  data-controller="local-storage"
  data-local-storage-key-value="trust-workforce-management-example-note"
>
  <div class="card-body">
    <h2 class="h4 card-title">
      localStorageへ保存する確認メモ
    </h2>

    <p class="text-body-secondary">
      このブラウザだけに保存されます。
      共有・正式保存が必要な業務データには
      PostgreSQLを使用します。
    </p>

    <div class="mb-3">
      <label
        class="form-label"
        for="example-note"
      >
        確認メモ
      </label>

      <input
        id="example-note"
        class="form-control"
        type="text"
        data-local-storage-target="input"
      >
    </div>

    <div class="d-flex gap-2 mb-3">
      <button
        class="btn btn-primary"
        type="button"
        data-action="local-storage#save"
      >
        端末内へ保存
      </button>

      <button
        class="btn btn-outline-danger"
        type="button"
        data-action="local-storage#clear"
      >
        削除
      </button>
    </div>

    <p class="mb-0">
      保存内容：
      <strong data-local-storage-target="output">
        未保存
      </strong>
    </p>
  </div>
</section>
