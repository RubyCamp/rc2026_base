<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || "勤務調整システム" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="勤務調整システム">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "bootstrap.min",
                            "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application",
                            "data-turbo-track": "reload" %>

    <%= javascript_include_tag "bootstrap.bundle.min",
                           defer: true,
                           "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-body-tertiary">
    <header>
      <nav
        class="navbar navbar-expand-md bg-dark border-bottom"
        data-bs-theme="dark"
        aria-label="メインメニュー"
      >
        <div class="container">
          <%= link_to "勤務調整システム",
                      root_path,
                      class: "navbar-brand fw-semibold" %>

          <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#main-navigation"
            aria-controls="main-navigation"
            aria-expanded="false"
            aria-label="メニューを開く"
          >
            <span class="navbar-toggler-icon"></span>
          </button>

          <div
            id="main-navigation"
            class="collapse navbar-collapse"
          >
            <ul class="navbar-nav ms-auto">
              <li class="nav-item">
                <%= link_to "全体案内", guide_path, class: "nav-link" %>
              </li>

              <li class="nav-item">
                <%= link_to "勤務依頼",
                            work_requests_path,
                            class: "nav-link" %>
              </li>

              <li class="nav-item">
                <%= link_to "スタッフ",
                            staff_members_path,
                            class: "nav-link" %>
              </li>

              <li class="nav-item">
                <%= link_to "勤務可否", availabilities_path, class: "nav-link" %>
              </li>

              <li class="nav-item">
                <%= link_to "人員状況", details_of_shifts_path, class: "nav-link" %>
              </li>

              <li class="nav-item">
                <%= link_to "仮割当", list_views_path, class: "nav-link" %>
              </li>

              <li class="nav-item">
                <%= link_to "シフト表", work_requests_shift_path, class: "nav-link" %>
              </li>

              <li class="nav-item">
                <%= link_to "変更履歴", change_events_path, class: "nav-link" %>
              </li>

              <li class="nav-item">
                <%= link_to "デモ管理", admin_demo_data_path, class: "nav-link" %>
              </li>

              <% if session[:role].present? %>
                <li class="nav-item">
                  <%= button_to "ログアウト", logout_path, method: :delete, class: "nav-link border-0 bg-transparent" %>
                </li>
              <% else %>
                <li class="nav-item">
                  <%= link_to "ログイン", login_path, class: "nav-link" %>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      </nav>
    </header>

    <main class="container py-4 py-md-5">
      <%= render "shared/page_ownership" %>

      <% if notice.present? %>
        <div class="alert alert-success" role="status">
          <%= notice %>
        </div>
      <% end %>

      <% if alert.present? %>
        <div class="alert alert-danger" role="alert">
          <%= alert %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
